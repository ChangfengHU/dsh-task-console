{
  "name": "dsh-task-console",
  "version": "0.13.2",
  "description": "Local-first Agent presets and task orchestration for DeepSeek Harness, backed by SQLite.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./typert": { "default": "./lib/typert.host.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib", "src", "prototype", "cordis.patch.yml", "README.md", "LICENSE", "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "NODE_ENV=test tsx --test test/*.test.ts",
    "kernel:check": "npm --prefix cloudflare run check"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "agent-preset", "task-console"],
  "repository": { "type": "git", "url": "https://github.com/ChangfengHU/dsh-task-console" },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@deepseek-ai/schemastery": "^3.18.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.13"
  }
}
