[Unit]
Description=Window manager for the linux-browser-vnc desktop
After=linux-browser-vnc-xvfb.service
Requires=linux-browser-vnc-xvfb.service
PartOf=linux-browser-vnc-xvfb.service

[Service]
Type=simple
User=linux-browser-vnc
Group=linux-browser-vnc
# DISPLAY is defined in desktop.env so every desktop unit shares one source.
EnvironmentFile=/etc/linux-browser-vnc/desktop.env
ExecStart=/usr/bin/openbox
Restart=always
RestartSec=2s
TimeoutStopSec=15s
KillMode=control-group

MemoryHigh=192M
MemoryMax=256M
TasksMax=64

UMask=0022
ProtectSystem=full
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
NoNewPrivileges=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/linux-browser-vnc

[Install]
WantedBy=multi-user.target
