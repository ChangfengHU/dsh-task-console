[Unit]
Description=Cloudflare named tunnel for Linux Clash Skill (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linux-clash-tunnel
Group=linux-clash-tunnel
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:0 run --token-file /etc/linux-clash-skill/tunnels/%i.token
Restart=always
RestartSec=5s
UMask=0077
StateDirectory=linux-clash-tunnel
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
NoNewPrivileges=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
